{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api?__vercel_route=$1"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/((?!assets/|images/|icon\\.svg|favicon\\.ico|manifest\\.webmanifest|sw\\.js|registerSW\\.js|workbox-.*\\.js).*)",
      "destination": "/index.html"
    }
  ]
}
