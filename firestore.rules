rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // System heartbeat & metadata
    match /system/{docId} {
      allow get, list, create, update, delete: if true;
    }

    // Multi-tenant organizations collection
    match /organizations/{orgId} {
      allow get: if isValidId(orgId);
      allow list: if true;
      allow create, update, delete: if isValidId(orgId);

      // Subcollections
      match /{subcol}/{docId} {
        allow get, create, update, delete: if isValidId(docId);
        allow list: if true;
      }
    }

    // Direct root collections for global multi-tenant access and synchronization
    match /services/{id} {
      allow get, create, update, delete: if isValidId(id);
      allow list: if true;
    }

    match /professionals/{id} {
      allow get, create, update, delete: if isValidId(id);
      allow list: if true;
    }

    match /queue/{id} {
      allow get, create, update, delete: if isValidId(id);
      allow list: if true;
    }

    match /appointments/{id} {
      allow get, create, update, delete: if isValidId(id);
      allow list: if true;
    }

    match /customers/{id} {
      allow get, create, update, delete: if isValidId(id);
      allow list: if true;
    }

    match /transactions/{id} {
      allow get, create, update, delete: if isValidId(id);
      allow list: if true;
    }

    match /reviews/{id} {
      allow get, create, update, delete: if isValidId(id);
      allow list: if true;
    }

    match /notifications/{id} {
      allow get, create, update, delete: if isValidId(id);
      allow list: if true;
    }

    match /auditLogs/{id} {
      allow get, create, update, delete: if isValidId(id);
      allow list: if true;
    }

    match /plans/{id} {
      allow get, create, update, delete: if isValidId(id);
      allow list: if true;
    }

    match /sessions/{id} {
      allow get, create, update, delete: if isValidId(id);
      allow list: if true;
    }

    match /config/{id} {
      allow get, create, update, delete: if isValidId(id);
      allow list: if true;
    }
  }
}
