# ==============================================================================
# BarberOS - Variáveis de Ambiente Recomendadas na Vercel
# ==============================================================================

# URL pública da sua aplicação na Vercel (sem barra no final)
# Exemplo: https://barberos.vercel.app
APP_URL="https://sua-url-na-vercel.vercel.app"

# ==============================================================================
# SUPABASE (PostgreSQL Cloud Relational Database)
# ==============================================================================
# URL do seu projeto no Supabase (ex: https://xsmcfrualbyswoccyicl.supabase.co)
SUPABASE_URL="https://xsmcfrualbyswoccyicl.supabase.co"

# Chave Anônima pública (anon key) e Chave de Serviço privada (service_role)
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ey..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ey..."

# ==============================================================================
# MERCADO PAGO (Produção ou Testes)
# ==============================================================================
# Access Token do Mercado Pago (inicia com APP_USR-...)
MERCADOPAGO_ACCESS_TOKEN="APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Webhook Secret do Mercado Pago (para validação de assinatura do webhook)
MERCADOPAGO_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxx"

# (Opcional) Chave Gemini AI caso utilize recursos generativos
GEMINI_API_KEY="MY_GEMINI_API_KEY"
